.navbar {
  background-color: steelblue;
}

.menu {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: 1fr;
}

.menu > li {
  position: relative;
}

.menu a {
  display: block;
  padding: 12px 18px;
  color: white;
  text-decoration: none;
}

.menu a:hover {
  background-color: rgba(255, 255, 255, 0.15);
}

.submenu {
  display: none;
  position: static;
  background-color: steelblue;
  list-style: none;
  padding: 0;
  margin: 0;
  min-width: 180px;
}

.has-submenu:hover .submenu {
  display: block;
}

.submenu li a {
  padding: 10px;
  white-space: nowrap;
}

.active {
  border: 2px solid white;
  border-radius: 20px;
}

.container {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20px;
}

.left,
.center,
.right,
.section {
  padding: 20px;
  background: #f9f9f9;
}

.section {
  background: #ffffff;
}

@media (min-width: 601px) {
  .menu {
    grid-template-columns: repeat(auto-fit, minmax(140px, auto));
    align-items: center;
  }

  .submenu {
    position: absolute;
  }

  .container {
    grid-template-columns: repeat(3, 1fr);
  }

  .section {
    grid-column: span 2;
  }
}
